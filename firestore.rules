rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Fonctions utilitaires ────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getMerchant(merchantId) {
      return get(/databases/$(database)/documents/merchants/$(merchantId)).data;
    }
    // Amitié RÉCIPROQUE : chacun doit avoir l'autre dans sa liste. Sinon n'importe qui pourrait
    // s'ajouter unilatéralement (friendUids est écrit par son propriétaire) et lire le profil d'un inconnu.
    function isFriendOf(otherUid) {
      return isAuth() &&
        otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friendUids', []) &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('friendUids', []);
    }
    // Réponses d'un ami : lisibles seulement s'il n'a pas coupé « Montrer mes réponses à mes amis »
    // (users.shareAnswers, activé par défaut). Le réglage est donc appliqué aussi côté règles.
    function friendSharesAnswers(otherUid) {
      return get(/databases/$(database)/documents/users/$(otherUid)).data.get('shareAnswers', true) != false;
    }
    // Une photo (avatar, logo, couverture) ne peut pointer que vers un fichier du compte lui-même :
    // /users/{uid}/... ou /merchants/{uid}/... dans le Storage. Impossible d'afficher la photo d'un autre.
    function ownFile(url, folder, id) {
      // Jeu de caractères restreint (pas de guillemets, chevrons ni espaces) : l'URL est ensuite
      // insérée dans des attributs HTML, elle ne doit jamais pouvoir en sortir.
      return url == null ||
        (url is string && url.matches('https://firebasestorage\\.googleapis\\.com/[A-Za-z0-9%._~:/?&=+-]*/o/' + folder + '%2F' + id + '%2F[A-Za-z0-9%._~:/?&=+-]*'));
    }
    // Admin = l'un des e-mails NOOVA ET vérifié (connexion Google ou lien de vérification). Sans « email_verified »,
    // n'importe qui pouvait créer un compte e-mail + mot de passe avec une adresse admin encore libre et tout lire.
    function isAdmin() {
      return isAuth() && request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') in ['noovaoffr@gmail.com', 'tomussproduction@gmail.com'];
    }
    // Compte de diffusion NOOVA (champ « broadcast » du commerçant, posé uniquement par l'admin) : ses questions
    // ciblent toutes les villes (targetCity « toutes »). Aucun autre commerçant ne peut viser toutes les villes.
    function isBroadcaster(uid) {
      return getMerchant(uid).get('broadcast', false) == true;
    }
    function campBroadcastOk(d) {
      return (d.get('targetCity', null) != 'toutes' && d.get('broadcast', false) != true) || isBroadcaster(request.auth.uid);
    }
    // Identifiant de document créé par un client : lettres, chiffres, _ et - seulement (jamais de guillemet ni de
    // chevron, qui pourraient être réinjectés dans une page).
    function safeId(id) { return id.matches('[A-Za-z0-9_-]{1,128}'); }
    function pollOptionsOk(o) {
      return o is list && o.size() >= 2 && o.size() <= 4 &&
        o[0] is string && o[0].size() > 0 && o[0].size() <= 60 && o[1] is string && o[1].size() > 0 && o[1].size() <= 60 &&
        (o.size() < 3 || (o[2] is string && o[2].size() > 0 && o[2].size() <= 60)) &&
        (o.size() < 4 || (o[3] is string && o[3].size() > 0 && o[3].size() <= 60));
    }
    function myName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('name', '');
    }
    function brandOf(uid) {
      return getMerchant(uid).get('brandName', '');
    }
    // Texte borné (nom, ville…) : chaîne courte, ou champ absent.
    function shortStr(d, k, n) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n);
    }
    // Champs d'un habitant tenus par le serveur (solde, réponses, série, notifications…) : jamais écrits par le client.
    function userServerFields() {
      return ['points','xp','noovs','dailyEarned','dailyEarnedDate','dailyAnswerCount','dailyAnswerDate','lastQuestionStart','streak','ans','lastAnswerDate','lastDailyDate','answeredCampaigns','demoClaimed','welcomeClaimed','streakDate','lastActivityAt','answeredMerchants','discoveryBonusDate','notifStats','notifPrefs','notifDaily','answerMinutes','dailyPoints','dailyPointsDate','dailyNoovs','dailyNoovsDate','predStats','weeklyNoovs','role','createdAt'];
    }
    function userTextOk(d) {
      return shortStr(d, 'name', 60) && shortStr(d, 'city', 80) && shortStr(d, 'cityLabel', 80) &&
        (!('email' in d) || d.email == '' || d.email == request.auth.token.get('email', ''));
    }
    // Champs d'un commerçant réservés à l'admin ou au serveur.
    function merchantAdminFields() {
      return ['status', 'verifiedAt', 'submittedAt', 'ownerUid', 'role', 'monthlyQuestionQuota', 'pointsGenerated', 'pointsSpent', 'broadcast', 'isTest', 'testQIdx', 'testLastDay', 'consentCount', 'verifiedPopupShown'];
    }
    function myCity() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('city', null);
    }

    // ─── Paliers de récompenses (identiques pour TOUS les commerçants) ───────────
    // Source unique : tiers.js (côté fonctions) — les règles ne peuvent pas importer de fichier, les valeurs sont donc
    // répétées ici ; tests/points_rules.js vérifie qu'elles restent identiques à tiers.js.
    //   palier :  1    2    3     4     5(gros lot)
    //   points : 150  300  500   900   1500     · prix carte : 1-3 €, 3-6 €, 6-10 €, 10-18 €, 18-30 €
    function tierPts(t) { return t == 1 ? 150 : (t == 2 ? 300 : (t == 3 ? 500 : (t == 4 ? 900 : 1500))); }
    function tierMax(t) { return t == 1 ? 3 : (t == 2 ? 6 : (t == 3 ? 10 : (t == 4 ? 18 : 30))); }
    function validTier(t) { return t is int && t >= 1 && t <= 5; }
    // Réglages d'une récompense (quota mensuel, créneaux, « avec achat »). Ne contient ni prix ni points : le commerçant n'en saisit jamais.
    function rewardSettingsOk(d) {
      return d.monthlyQuota is int && d.monthlyQuota >= 1 && d.monthlyQuota <= 1000 &&
        d.get('timeSlots', []) is list && d.get('timeSlots', []).size() <= 3 &&
        d.withPurchase is bool &&
        (d.withPurchase == false ? d.get('minPurchase', null) == null
          : (d.get('minPurchase', null) is number && d.minPurchase > 0 && d.minPurchase <= 2 * tierMax(d.tier)));
    }
    // Contenu à faire valider par l'admin : intitulé, icône, confirmation de la fourchette de prix carte.
    function rewardContentOk(d) {
      return d.label is string && d.label.size() >= 3 && d.label.size() <= 80 &&
        (d.get('icon', null) == null || (d.icon is string && d.icon.size() <= 8)) &&
        d.priceConfirmed == true;
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Lecture : soi-même ou l'admin, JAMAIS un autre habitant (e-mail, âge, centres d'intérêt, appareils…). Les autres
    // ne voient que les copies réduites tenues par le serveur : cityBoard (classement) et publicProfiles (amis).
    // Écriture : propriétaire uniquement
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // À la création, un compte démarre TOUJOURS à zéro : impossible de s'inscrire avec un solde.
      allow create: if isOwner(uid) && ownFile(request.resource.data.get('photoUrl', null), 'users', uid) &&
        userTextOk(request.resource.data) &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('points', 0) == 0 && request.resource.data.get('xp', 0) == 0 &&
        request.resource.data.get('noovs', 0) == 0 && request.resource.data.get('streak', 0) == 0 &&
        request.resource.data.get('dailyEarned', 0) == 0 &&
        request.resource.data.get('lastAnswerDate', null) == null && request.resource.data.get('lastDailyDate', null) == null &&
        request.resource.data.get('answeredCampaigns', []).size() == 0 &&
        request.resource.data.get('demoClaimed', false) == false && request.resource.data.get('welcomeClaimed', false) == false &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time) &&
        !request.resource.data.keys().hasAny(['ans','dailyAnswerCount','dailyAnswerDate','lastQuestionStart','lastActivityAt','answeredMerchants','discoveryBonusDate','notifStats','notifPrefs','notifDaily','answerMinutes','dailyPoints','dailyPointsDate','dailyNoovs','dailyNoovsDate','predStats','weeklyNoovs','streakDate','friendUids']);
      // Le solde de points (points/xp/noovs…) et tout ce qui sert à le calculer passent UNIQUEMENT par les Cloud Functions
      // (SDK Admin, hors règles) : submitAnswer (réponses, bonus découverte), claimWelcomeBonus (+50), redeemReward (échange),
      // expirePoints. Le client ne peut jamais écrire ces champs, pas même pour débiter : le solde ne peut donc pas devenir
      // négatif et les limites d'échange (quota, une récompense par semaine) ne peuvent pas être contournées.
      allow update: if isAdmin() || (isOwner(uid) &&
        ownFile(request.resource.data.get('photoUrl', null), 'users', uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'city', 'cityLabel', 'email']) || userTextOk(request.resource.data)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(userServerFields()));
      allow delete: if isOwner(uid) || isAdmin();

      // Notifications subcollection
      // Les seules notifications créées par un autre habitant sont les demandes d'ami et leurs
      // acceptations, avec un identifiant DÉTERMINISTE (un seul doc par expéditeur) : un doublon
      // est structurellement impossible (le second envoi serait une mise à jour, refusée).
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid);
        allow create: if isAdmin() || (isAuth() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.auth.uid != uid &&
          // Le nom affiché est le sien : impossible d'envoyer une demande au nom de quelqu'un d'autre (ou de « NOOVA »).
          request.resource.data.get('fromName', '') in [myName(), 'Un utilisateur', 'Quelqu\'un'] &&
          ((request.resource.data.type == 'friend_request' && notifId == 'friendreq_' + request.auth.uid) ||
           (request.resource.data.type == 'friend_accepted' && notifId == 'friendacc_' + request.auth.uid)));
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── Copies publiques (écrites UNIQUEMENT par le serveur, functions/publicProfiles.js) ───
    // Classement / groupes : habitants de MA ville (nom, photo, XP, série, groupes).
    match /cityBoard/{uid} {
      allow read: if isAuth() && (isAdmin() || (myCity() != null && resource.data.city == myCity()));
      allow write: if false;
    }
    // Profil vu par un ami : uniquement entre amis RÉCIPROQUES.
    match /publicProfiles/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid) || isAdmin();
      allow write: if false;
    }
    // Vitrine d'un commerce vérifié : habitants de sa ville (le compte NOOVA, diffusé partout : tous les habitants).
    match /merchantsPublic/{merchantId} {
      allow read: if isAuth() && (
        isAdmin() || merchantId == request.auth.uid ||
        (resource.data.status == 'verified' && (resource.data.get('broadcast', false) == true || resource.data.get('city', null) == myCity())));
      allow write: if false;
    }

    // ─── Merchants ────────────────────────────────────────────────────────────
    // Lecture : le commerçant lui-même ou l'admin (e-mail, téléphone, gérant, SIRET, pièce d'identité). Les habitants
    // lisent merchantsPublic.
    // Écriture : uniquement le propriétaire (ownerUid) OU admin
    match /merchants/{merchantId} {
      allow read: if isAuth() && (
        resource.data.ownerUid == request.auth.uid ||
        merchantId == request.auth.uid ||
        isAdmin()
      );
      // Un compte commerçant démarre toujours en attente de vérification (jamais 'verified').
      allow create: if isAuth() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.auth.uid == merchantId
      ) && request.resource.data.get('status', null) == 'pending' &&
        request.resource.data.get('role', 'merchant') == 'merchant' &&
        // Aucun privilège à la création : ni quota, ni compte de test, ni diffusion, ni compteurs.
        !request.resource.data.keys().hasAny(['verifiedAt', 'monthlyQuestionQuota', 'pointsGenerated', 'pointsSpent', 'broadcast', 'isTest', 'testQIdx', 'testLastDay', 'consentCount', 'verifiedPopupShown']) &&
        shortStr(request.resource.data, 'brandName', 80) && shortStr(request.resource.data, 'name', 80) &&
        (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.get('email', '')) &&
        ownFile(request.resource.data.get('logoUrl', null), 'merchants', merchantId) &&
        ownFile(request.resource.data.get('coverUrl', null), 'merchants', merchantId);
      // Le commerçant peut modifier son profil (nom, secteur, ville, description...)
      // mais jamais son propre statut de vérification ni son ownerUid/role — seul
      // l'admin peut faire passer un compte pending -> verified/rejected.
      allow update: if isAuth() && (
        isAdmin() ||
        (
          (resource.data.ownerUid == request.auth.uid || merchantId == request.auth.uid) &&
          ownFile(request.resource.data.get('logoUrl', null), 'merchants', merchantId) &&
          ownFile(request.resource.data.get('coverUrl', null), 'merchants', merchantId) &&
          shortStr(request.resource.data, 'brandName', 80) && shortStr(request.resource.data, 'name', 80) &&
          // Un commerce VÉRIFIÉ ne change ni de nom, ni de SIRET, ni de ville sans repasser par NOOVA (usurpation).
          (resource.data.get('status', null) != 'verified' ||
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['brandName', 'name', 'siret', 'city'])) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(merchantAdminFields())
            ||
            // « Corriger et renvoyer » : un dossier refusé (à corriger) repasse en attente,
            // sans jamais pouvoir se déclarer vérifié soi-même.
            (resource.data.status == 'rejected' && request.resource.data.status == 'pending' &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedAt', 'ownerUid', 'role', 'monthlyQuestionQuota', 'pointsGenerated', 'pointsSpent', 'broadcast', 'isTest', 'testQIdx', 'testLastDay', 'consentCount', 'verifiedPopupShown']))
            ||
            // Popup « vous êtes vérifié » vue : seul ce drapeau, et seulement à true.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedPopupShown']) && request.resource.data.verifiedPopupShown == true)
          )
        )
      );
      allow delete: if isAdmin();

      // Notifications subcollection (annonces admin, popup de vérification…)
      match /notifications/{notifId} {
        allow read: if isOwner(merchantId) || isAdmin();
        allow update: if isOwner(merchantId);
        allow create: if isAdmin() || isOwner(merchantId);
        allow delete: if isOwner(merchantId) || isAdmin();
      }
    }

    // ─── Campaigns ────────────────────────────────────────────────────────────
    // Lecture : campagnes actives de MA ville pour tous les users connectés, ou par le commerçant propriétaire
    // Écriture : uniquement le commerçant propriétaire, vérifié, avec validation des champs
    match /campaigns/{campaignId} {
      allow read: if isAuth() && (
        (resource.data.status == 'active' && resource.data.get('targetCity', null) == 'toutes') ||
        (resource.data.status == 'active' && resource.data.get('targetCity', null) == myCity()) ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && safeId(campaignId) &&
        request.resource.data.merchantId == request.auth.uid &&
        request.resource.data.questions.size() <= 3 &&
        request.resource.data.status in ['active', 'draft', 'paused'] &&
        request.resource.data.get('archived', false) == false &&
        getMerchant(request.auth.uid).get('status', null) == 'verified' &&
        campBroadcastOk(request.resource.data) &&
        // Le nom affiché est celui du commerce (jamais celui d'un autre) ; ni « test », ni compteurs gonflés.
        request.resource.data.get('merchantName', '') == brandOf(request.auth.uid) &&
        !request.resource.data.keys().hasAny(['isTest', 'postedByNoova', 'blockedReason']) &&
        request.resource.data.get('answersCount', 0) == 0 && request.resource.data.get('responsesCount', 0) == 0 &&
        ownFile(request.resource.data.get('merchantLogoUrl', null), 'merchants', request.auth.uid) &&
        (getMerchant(request.auth.uid).get('city', null) == null ||
         request.resource.data.get('targetCity', null) == getMerchant(request.auth.uid).get('city', null) ||
         (request.resource.data.get('targetCity', null) == 'toutes' && isBroadcaster(request.auth.uid))) &&
        // Lancer une campagne exige les 5 paliers de la vitrine récompenses remplis (un document par palier),
        // sauf pour le compte de diffusion NOOVA.
        (request.resource.data.status != 'active' || isBroadcaster(request.auth.uid) || (
          exists(/databases/$(database)/documents/rewards/$(request.auth.uid + '_p1')) &&
          exists(/databases/$(database)/documents/rewards/$(request.auth.uid + '_p2')) &&
          exists(/databases/$(database)/documents/rewards/$(request.auth.uid + '_p3')) &&
          exists(/databases/$(database)/documents/rewards/$(request.auth.uid + '_p4')) &&
          exists(/databases/$(database)/documents/rewards/$(request.auth.uid + '_p5'))));
      // answersCount/responsesCount ne sont plus incrémentables par le client : seule la
      // Cloud Function submitAnswer (SDK Admin, hors règles) les met à jour désormais. Le
      // commerçant ne peut pas non plus changer merchantId (transfert de propriété).
      allow update: if isAuth() && (
        isAdmin() ||
        (resource.data.merchantId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answersCount', 'responsesCount', 'merchantId', 'blockedReason', 'isTest', 'postedByNoova', 'merchantName']) &&
         ownFile(request.resource.data.get('merchantLogoUrl', null), 'merchants', request.auth.uid) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['targetCity', 'broadcast']) || campBroadcastOk(request.resource.data)) &&
         // Quota mensuel : une campagne bloquée le reste, et on ne peut pas ajouter de questions après coup —
         // mais un BROUILLON (jamais lancé, jamais compté dans le quota) reste librement modifiable, y
         // compris pour y ajouter des questions au fil de la rédaction (autosave, voir noova_dashboard.html).
         resource.data.status != 'blocked' && request.resource.data.status != 'blocked' &&
         (resource.data.status == 'draft' ||
          request.resource.data.get('questions', []).size() <= resource.data.get('questions', []).size()) &&
         // Archivage : seulement une campagne terminée (jamais une campagne encore diffusée).
         (request.resource.data.get('archived', false) != true || request.resource.data.status == 'completed'))
      );
      allow delete: if isAuth() && (resource.data.merchantId == request.auth.uid || isAdmin());
    }

    // ─── Answers ─────────────────────────────────────────────────────────────
    // Création : uniquement par l'auteur (userId doit matcher)
    // Lecture : par l'auteur OU par le commerçant de la campagne
    match /answers/{answerId} {
      // Seule la Cloud Function submitAnswer (SDK Admin, hors règles) crée des réponses
      // désormais — elle seule peut re-vérifier éligibilité/barème/doublon côté serveur.
      allow create: if false;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        (isFriendOf(resource.data.userId) && friendSharesAnswers(resource.data.userId)) ||
        isAdmin()
      );
      // Modération : l'admin peut uniquement lever/poser le flag anti-abus
      allow update: if isAuth() && isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagged']);
      // delete : uniquement par l'auteur (suppression de compte / droit à l'effacement)
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── Rewards ─────────────────────────────────────────────────────────────
    // Lecture : récompenses actives de MA ville pour tous les users connectés
    // Écriture : uniquement le commerçant propriétaire, vérifié
    // Actualités « Ton avis a compté » : le commerçant vérifié propose (toujours « pending »), l'admin
    // publie ou refuse. Seules les actualités publiées sont lisibles par les habitants.
    match /merchantPosts/{postId} {
      allow read: if isAuth() && (resource.data.status == 'published' || resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if isAuth() && safeId(postId) &&
        request.resource.data.merchantId == request.auth.uid &&
        getMerchant(request.auth.uid).get('status', null) == 'verified' &&
        request.resource.data.get('merchantName', '') == brandOf(request.auth.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(['merchantId', 'merchantName', 'text', 'campaignIds', 'kind', 'status', 'city', 'createdAt']) &&
        request.resource.data.get('kind', 'impact') in ['impact', 'news', 'new', 'top'] &&
        request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 200 &&
        request.resource.data.campaignIds is list && request.resource.data.campaignIds.size() <= 3;
      allow update: if isAuth() && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedAt', 'publishedAt'])) ||
        (resource.data.merchantId == request.auth.uid &&
         resource.data.status in ['pending', 'rejected'] &&
         request.resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'campaignIds', 'kind', 'status', 'rejectionReason']) &&
         request.resource.data.get('kind', 'impact') in ['impact', 'news', 'new', 'top'] &&
         request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 200 &&
         request.resource.data.campaignIds is list && request.resource.data.campaignIds.size() <= 3)
      );
      allow delete: if isAuth() && ((resource.data.merchantId == request.auth.uid && resource.data.status != 'published') || isAdmin());
    }
    match /rewards/{rewardId} {
      allow read: if isAuth() && (
        (resource.data.active == true && resource.data.get('city', null) == myCity()) ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      // Exactement 5 paliers par commerçant : un document par palier, à l'identifiant imposé {merchantId}_p{1..5}, donc jamais
      // plus de 5 ni deux fois le même. Le coût en points est celui du palier (tierPts) : le commerçant n'en saisit aucun.
      // Une récompense démarre toujours en attente de validation admin, jamais visible/active avant.
      allow create: if isAuth() &&
        request.resource.data.merchantId == request.auth.uid &&
        getMerchant(request.auth.uid).get('status', null) in ['pending', 'verified'] &&
        request.resource.data.get('merchantName', '') == brandOf(request.auth.uid) &&
        request.resource.data.keys().hasOnly(['merchantId','merchantName','city','tier','slot','cost','label','icon','priceConfirmed','monthlyQuota','timeSlots','withPurchase','minPurchase','status','active','approved','redeemedCount','createdAt','updatedAt']) &&
        validTier(request.resource.data.get('tier', null)) &&
        rewardId == request.auth.uid + '_p' + string(request.resource.data.tier) &&
        request.resource.data.get('slot', null) == request.resource.data.tier &&
        request.resource.data.get('cost', null) == tierPts(request.resource.data.tier) &&
        rewardContentOk(request.resource.data) && rewardSettingsOk(request.resource.data) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.active == false &&
        request.resource.data.get('approved', null) == false &&
        request.resource.data.get('redeemedCount', null) == 0;
      // Le champ « approved » (et donc le passage en « approved ») est réservé à l'admin.
      allow update: if isAuth() && (
        (isAdmin() && (request.resource.data.get('approved', false) != true ||
                       (validTier(request.resource.data.get('tier', null)) && request.resource.data.get('cost', null) == tierPts(request.resource.data.tier))))
        ||
        (resource.data.merchantId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['merchantId','merchantName','city','tier','slot','cost','approved','approvedAt','redeemedCount','createdAt','rejectionReason']) &&
         rewardSettingsOk(request.resource.data) &&
         (
           // Réglages (quota, créneaux, « avec achat ») et pause / reprise : sans nouvelle validation. On ne peut reprendre qu'une
           // récompense DÉJÀ approuvée par l'admin (approved == true) ; jamais passer de « pending » à « approved » soi-même.
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','active','updatedAt','monthlyQuota','timeSlots','withPurchase','minPurchase']) &&
            (request.resource.data.status == resource.data.status ||
             (resource.data.get('approved', false) == true &&
              ((resource.data.status == 'approved' && request.resource.data.status == 'paused') ||
               (resource.data.status == 'paused' && request.resource.data.status == 'approved')))) &&
            request.resource.data.active == (request.resource.data.status == 'approved' && resource.data.get('approved', false) == true))
           ||
           // Nouveau contenu (intitulé, icône…) : repasse en attente de validation, désactivée.
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','icon','priceConfirmed','status','active','updatedAt','monthlyQuota','timeSlots','withPurchase','minPurchase']) &&
            rewardContentOk(request.resource.data) &&
            request.resource.data.status == 'pending' &&
            request.resource.data.active == false)
         ))
      );
      // Le commerçant met en pause au lieu de supprimer (les 5 paliers doivent toujours exister) ; seul l'admin supprime.
      allow delete: if isAdmin();
    }

    // ─── Redemptions ─────────────────────────────────────────────────────────
    // Création : JAMAIS par le client — uniquement la fonction redeemReward (SDK Admin), qui débite les points et applique le
    // quota mensuel et la limite d'une récompense par commerçant et par semaine dans la même transaction.
    // Lecture : par l'utilisateur OU le commerçant concerné
    match /redemptions/{redemptionId} {
      allow create: if false;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      // Le commerçant peut passer le bon à "used" (validation au comptoir)
      // L'habitant peut aussi presser « C'est validé » sur son propre bon en attente.
      // Le commerçant renseigne aussi, au comptoir, le montant du panier et s'il s'agit d'un nouveau client (tableau de bord).
      allow update: if isAuth() && request.resource.data.status == 'used' && (
        (resource.data.merchantId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt','basketEuros','newCustomer']) &&
         (request.resource.data.get('basketEuros', null) == null || (request.resource.data.basketEuros is number && request.resource.data.basketEuros > 0 && request.resource.data.basketEuros <= 5000)) &&
         (request.resource.data.get('newCustomer', null) == null || request.resource.data.newCustomer is bool))
        ||
        (resource.data.userId == request.auth.uid && resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt']))
      );
      // delete : uniquement par l'utilisateur concerné (suppression de compte / droit à l'effacement)
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── CommunityEvents ─────────────────────────────────────────────────────
    // Lecture : événements de MA ville uniquement
    // Création : uniquement pour soi-même
    match /communityEvents/{eventId} {
      // Le fil n'est visible que pour : ses propres événements, ceux de ses amis (réciproques) et les
      // actualités des commerces QU'IL A AUTORISÉS (déjà limités à sa ville par l'autorisation). Jamais l'activité d'un inconnu ni d'un commerce non autorisé.
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', null) == request.auth.uid ||
        (resource.data.get('type', null) == 'merchant_post' &&
         resource.data.get('merchantId', null) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('authorizedMerchants', [])) ||
        (resource.data.get('userId', null) != null && isFriendOf(resource.data.userId))
      );
      // Les événements du fil (palier atteint, série, actualité publiée) sont créés par le serveur : un client ne peut pas en forger.
      allow create: if false;
      allow update: if false;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

      // "J'aime" : un doc = un like d'un user (id = son uid), pour empêcher tout double-like
      // et éviter de devoir valider un diff de tableau dans les règles.
      match /likes/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isAuth() && uid == request.auth.uid;
      }

      // Commentaires : un par auteur identifié (userId == uid), texte court, supprimables par leur auteur.
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && safeId(commentId) &&
          request.resource.data.keys().hasOnly(['userId', 'name', 'text', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          // Le nom affiché est le sien (impossible de commenter au nom de quelqu'un d'autre).
          request.resource.data.get('name', '') in [myName(), 'Quelqu\'un'] &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
        allow update: if false;
        allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ─── WeeklyQuestions ─────────────────────────────────────────────────────
    // Question communautaire hebdomadaire, publiée par l'admin dans le feed d'une ville
    // (ou de toutes). Lecture : tout user de la ville concernée. Écriture : admin seul.
    // Retours des testeurs (profil → « Ton avis sur NOOVA ») : un habitant crée les siens, seul l'admin les lit et
    // les traite. Champs et tailles bornés (pas de document géant, pas de champ inattendu).
    match /feedback/{id} {
      allow create: if isAuth() && safeId(id)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'city', 'rating', 'likes', 'dislikes', 'kind', 'text', 'platform', 'standalone', 'status', 'createdAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.kind in ['idee', 'bug', 'remarque']
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.likes is list && request.resource.data.likes.size() <= 10
        && request.resource.data.dislikes is list && request.resource.data.dislikes.size() <= 10
        && request.resource.data.status == 'nouveau'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /weeklyQuestions/{qId} {
      allow read: if isAuth() && (resource.data.get('city', null) == 'all' || resource.data.get('city', null) == myCity() || isAdmin());
      allow create, update, delete: if isAdmin();
      match /votes/{uid} {
        // Son propre vote seulement (les totaux sont sur la question) : personne ne voit ce qu'un autre a voté.
        allow read: if isOwner(uid) || isAdmin();
        // Un vote = un choix valide de la question, rien d'autre (pas d'index hors liste, pas de champ en plus).
        allow create: if isAuth() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['optionIndex', 'createdAt'])
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < get(/databases/$(database)/documents/weeklyQuestions/$(qId)).data.options.size();
        allow update, delete: if false;
      }
    }

    // ─── FriendCodes ─────────────────────────────────────────────────────────
    // Annuaire public des codes amis — lecture ouverte à tous les users connectés
    // Seul le propriétaire du code peut le créer (uid == auth.uid)
    match /friendCodes/{code} {
      // Lecture d'UN code connu seulement (ajout d'ami) : jamais la liste (elle donnerait le prénom de tous les inscrits).
      allow get: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid && code.matches('NOOVA-[A-Z0-9]{4,10}') &&
        request.resource.data.keys().hasOnly(['uid', 'name']) && shortStr(request.resource.data, 'name', 60);
      allow update: if isAuth() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'name']) && shortStr(request.resource.data, 'name', 60);
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── Broadcasts ──────────────────────────────────────────────────────────
    // Historique des notifications diffusées par l'admin
    // ─── Annonces de NOOVA (onglet Diffusion) ─────────────────────────────────
    // Créées par l'admin ; envoyées (cloche + téléphone) par le serveur (functions/announcements.js). Un habitant lit
    // celles qui le visent : toutes les villes, ou la sienne.
    match /announcements/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.forUsers == true &&
        (resource.data.city == 'all' || resource.data.city == myCity()));
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['title', 'message', 'cta', 'city', 'forUsers', 'forMerchants', 'important', 'createdAt', 'sentBy']) &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 240 &&
        shortStr(request.resource.data, 'title', 60) && request.resource.data.city is string &&
        request.resource.data.cta in ['', 'questions', 'rewards', 'invite', 'friends'] &&
        request.resource.data.forUsers is bool && request.resource.data.forMerchants is bool && request.resource.data.important is bool &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      // Suppression par l'admin : elle disparaît de l'accueil en direct ; le serveur retire aussi la ligne des cloches.
      allow delete: if isAdmin();
    }

    match /broadcasts/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Chats ───────────────────────────────────────────────────────────────
    // Accès uniquement aux participants (stockés dans participants map du doc chat)
    match /chats/{chatId} {
      // members (écrit par le serveur) : permet la requête « mes conversations » (array-contains).
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participants ||
        request.auth.uid in resource.data.get('members', []) || isAdmin());
      // Création : les deux participants ; members (= les mêmes) et startedAt (heure serveur) pour que la conversation
      // apparaisse tout de suite dans « Messages », même avant le premier message.
      allow create: if isAuth() && safeId(chatId) && request.auth.uid in request.resource.data.participants &&
        request.resource.data.keys().hasOnly(['participants', 'members', 'startedAt']) && request.resource.data.participants.size() == 2 &&
        (!('members' in request.resource.data) || request.resource.data.members.toSet() == request.resource.data.participants.keys().toSet()) &&
        (!('startedAt' in request.resource.data) || request.resource.data.startedAt == request.time);
      // Accusé de lecture : chaque participant ne met à jour que SA date de dernière lecture (lastRead.<son uid>).
      allow update: if isAuth() && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRead']) &&
        request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.lastRead[request.auth.uid] == request.time;
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isAuth() &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        // Message texte, ou sondage (« type: poll ») : une question et 2 à 4 réponses courtes.
        allow create: if isAuth() && safeId(msgId) &&
          request.resource.data.keys().hasOnly(['fromUid', 'text', 'createdAt', 'type', 'options']) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
          (request.resource.data.get('type', 'text') == 'text' && !('options' in request.resource.data) ||
           (request.resource.data.get('type', 'text') == 'poll' && pollOptionsOk(request.resource.data.get('options', null)))) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Vote à un sondage : chaque participant écrit seulement SON choix (votes.<son uid> = numéro d'une réponse).
        allow update: if isAuth() && resource.data.get('type', 'text') == 'poll' &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
          request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.votes[request.auth.uid] is int &&
          request.resource.data.votes[request.auth.uid] >= 0 && request.resource.data.votes[request.auth.uid] < resource.data.options.size();
        allow delete: if isAdmin();
      }
    }

    // ─── Cities ──────────────────────────────────────────────────────────────
    match /cities/{cityId} {
      allow read: if isAuth();
      // Inscription : un habitant crée/met à jour le libellé (court) et le compteur de sa ville, rien d'autre ;
      // seul l'admin peut changer 'active' (ouverture/fermeture de la ville). Le compteur est recalculé par le serveur.
      allow create: if isAdmin() || (isAuth() && cityId.matches('[a-z0-9-]{1,60}') &&
        request.resource.data.keys().hasOnly(['label', 'count']) &&
        request.resource.data.label is string && request.resource.data.label.size() <= 60 &&
        request.resource.data.get('count', 0) is int);
      allow update: if isAdmin() || (isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','count']) &&
        request.resource.data.label is string && request.resource.data.label.size() <= 60 &&
        request.resource.data.count is int);
      allow delete: if false;
    }

    // ─── Friend notifications ─────────────────────────────────────────────────
    match /friendNotifications/{notifId} {
      allow read: if isAuth() && resource.data.toUid == request.auth.uid;
      allow create: if isAuth() && safeId(notifId) && request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromName', 'type', 'read', 'createdAt']) &&
        shortStr(request.resource.data, 'fromName', 60);
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Consent events ──────────────────────────────────────────────────────
    // Journal horodaté des octrois/révocations de consentement (preuve RGPD Art. 7).
    // Création : uniquement par l'utilisateur concerné. Lecture : l'utilisateur,
    // le commerçant concerné, ou l'admin. Jamais modifiable ni supprimable (journal).
    match /consentEvents/{eventId} {
      allow create: if isAuth() && safeId(eventId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'merchantId', 'action', 'segment', 'createdAt']) &&
        request.resource.data.merchantId is string && request.resource.data.action in ['granted', 'revoked'] &&
        request.resource.data.createdAt == request.time;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    // ─── Notifications : journal, file d'attente et métriques écrits UNIQUEMENT par les Cloud Functions ───
    // (SDK Admin hors règles). Les métriques par type alimentent le back-office (lecture admin).
    match /notifMetrics/{type} { allow read: if isAdmin(); allow write: if false; }
    match /notifLog/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /notifQueue/{id}     { allow read, write: if false; }
    // Compteurs de réponses par option (reveal) : serveur uniquement, jamais lisibles avant d'avoir répondu.
    match /campaignStats/{id}  { allow read, write: if false; }
    match /compatCache/{id}    { allow read, write: if false; }
    match /consentState/{id}   { allow read, write: if false; }
    // Réglages d'engagement : lus/écrits uniquement par les fonctions (l'admin passe par getEngagementConfig).
    match /appConfig/{id}      { allow read, write: if false; }
    match /mail/{id}           { allow read, write: if false; }
    // État du mois de test (commerces fictifs) : écrit par les fonctions, lu par l'admin.
    match /config/{id}         { allow read: if isAdmin(); allow write: if false; }
    // Zones ouvertes automatiquement (functions/autoZones.js) : écrites par le serveur, lues par l'admin.
    match /zones/{id}          { allow read: if isAdmin(); allow write: if false; }
    // Index des empreintes d'e-mail (recherche par contacts) : serveur uniquement, jamais lisible par un client.
    match /emailIndex/{id}     { allow read, write: if false; }
    match /rateLimits/{id}     { allow read, write: if false; }
  }
}
