rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Fonctions utilitaires ────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getMerchant(merchantId) {
      return get(/databases/$(database)/documents/merchants/$(merchantId)).data;
    }
    // Amitié RÉCIPROQUE : chacun doit avoir l'autre dans sa liste. Sinon n'importe qui pourrait
    // s'ajouter unilatéralement (friendUids est écrit par son propriétaire) et lire le profil d'un inconnu.
    function isFriendOf(otherUid) {
      return isAuth() &&
        otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friendUids', []) &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('friendUids', []);
    }
    // Réponses d'un ami : lisibles seulement s'il n'a pas coupé « Montrer mes réponses à mes amis »
    // (users.shareAnswers, activé par défaut). Le réglage est donc appliqué aussi côté règles.
    function friendSharesAnswers(otherUid) {
      return get(/databases/$(database)/documents/users/$(otherUid)).data.get('shareAnswers', true) != false;
    }
    // Une photo (avatar, logo, couverture) ne peut pointer que vers un fichier du compte lui-même :
    // /users/{uid}/... ou /merchants/{uid}/... dans le Storage. Impossible d'afficher la photo d'un autre.
    function ownFile(url, folder, id) {
      // Jeu de caractères restreint (pas de guillemets, chevrons ni espaces) : l'URL est ensuite
      // insérée dans des attributs HTML, elle ne doit jamais pouvoir en sortir.
      return url == null ||
        (url is string && url.matches('https://firebasestorage\\.googleapis\\.com/[A-Za-z0-9%._~:/?&=+-]*/o/' + folder + '%2F' + id + '%2F[A-Za-z0-9%._~:/?&=+-]*'));
    }
    function isAdmin() {
      return isAuth() && request.auth.token.email in ['noovaoffr@gmail.com', 'tomussproduction@gmail.com'];
    }
    function myCity() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('city', null);
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Lecture : soi-même, ses amis, les autres users de sa propre ville (classement/groupes), ou l'admin
    // Écriture : propriétaire uniquement
    match /users/{uid} {
      allow read: if isOwner(uid) ||
        isFriendOf(uid) ||
        isAdmin() ||
        (isAuth() && myCity() != null && resource.data.get('city', null) == myCity());
      // À la création, un compte démarre TOUJOURS à zéro : impossible de s'inscrire avec un solde.
      allow create: if isOwner(uid) && ownFile(request.resource.data.get('photoUrl', null), 'users', uid) &&
        request.resource.data.get('points', 0) == 0 && request.resource.data.get('xp', 0) == 0 &&
        request.resource.data.get('noovs', 0) == 0 && request.resource.data.get('demoClaimed', false) == false;
      // Le crédit de points (points/xp/dailyEarned/streak/ans/lastAnswerDate/answeredCampaigns)
      // passe uniquement par la Cloud Function submitAnswer (SDK Admin, hors règles) — le
      // client ne peut plus jamais écrire librement ces champs. Seule exception tolérée : le
      // DÉBIT de points lors d'un échange de récompense (points ne peut alors que baisser).
      allow update: if isAdmin() || (isOwner(uid) &&
        ownFile(request.resource.data.get('photoUrl', null), 'users', uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['points','xp','noovs','dailyEarned','dailyEarnedDate','dailyAnswerCount','dailyAnswerDate','lastQuestionStart','streak','ans','lastAnswerDate','lastDailyDate','answeredCampaigns','demoClaimed','notifStats','notifPrefs','notifDaily','answerMinutes','dailyPoints','dailyPointsDate','predStats']
        )
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']) &&
         request.resource.data.points < resource.data.points &&
         request.resource.data.points >= 0)
      ));
      allow delete: if isOwner(uid) || isAdmin();

      // Notifications subcollection
      // Les seules notifications créées par un autre habitant sont les demandes d'ami et leurs
      // acceptations, avec un identifiant DÉTERMINISTE (un seul doc par expéditeur) : un doublon
      // est structurellement impossible (le second envoi serait une mise à jour, refusée).
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid);
        allow create: if isAdmin() || (isAuth() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.auth.uid != uid &&
          ((request.resource.data.type == 'friend_request' && notifId == 'friendreq_' + request.auth.uid) ||
           (request.resource.data.type == 'friend_accepted' && notifId == 'friendacc_' + request.auth.uid)));
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ─── Merchants ────────────────────────────────────────────────────────────
    // Lecture : commerçant vérifié de MA ville (onboarding/découverte) OU propriétaire OU admin
    // Écriture : uniquement le propriétaire (ownerUid) OU admin
    match /merchants/{merchantId} {
      allow read: if isAuth() && (
        (resource.data.status == 'verified' && resource.data.get('city', null) == myCity()) ||
        resource.data.ownerUid == request.auth.uid ||
        merchantId == request.auth.uid ||
        isAdmin()
      );
      // Un compte commerçant démarre toujours en attente de vérification (jamais 'verified').
      allow create: if isAuth() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.auth.uid == merchantId
      ) && request.resource.data.get('status', null) == 'pending' &&
        ownFile(request.resource.data.get('logoUrl', null), 'merchants', merchantId) &&
        ownFile(request.resource.data.get('coverUrl', null), 'merchants', merchantId);
      // Le commerçant peut modifier son profil (nom, secteur, ville, description...)
      // mais jamais son propre statut de vérification ni son ownerUid/role — seul
      // l'admin peut faire passer un compte pending -> verified/rejected.
      allow update: if isAuth() && (
        isAdmin() ||
        (
          (resource.data.ownerUid == request.auth.uid || merchantId == request.auth.uid) &&
          ownFile(request.resource.data.get('logoUrl', null), 'merchants', merchantId) &&
          ownFile(request.resource.data.get('coverUrl', null), 'merchants', merchantId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verifiedAt', 'submittedAt', 'ownerUid', 'role'])
            ||
            // « Corriger et renvoyer » : un dossier refusé (à corriger) repasse en attente,
            // sans jamais pouvoir se déclarer vérifié soi-même.
            (resource.data.status == 'rejected' && request.resource.data.status == 'pending' &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedAt', 'ownerUid', 'role']))
          )
        )
      );
      allow delete: if isAdmin();

      // Notifications subcollection (annonces admin, popup de vérification…)
      match /notifications/{notifId} {
        allow read: if isOwner(merchantId) || isAdmin();
        allow update: if isOwner(merchantId);
        allow create: if isAdmin() || isOwner(merchantId);
        allow delete: if isOwner(merchantId) || isAdmin();
      }
    }

    // ─── Campaigns ────────────────────────────────────────────────────────────
    // Lecture : campagnes actives de MA ville pour tous les users connectés, ou par le commerçant propriétaire
    // Écriture : uniquement le commerçant propriétaire, vérifié, avec validation des champs
    match /campaigns/{campaignId} {
      allow read: if isAuth() && (
        (resource.data.status == 'active' && resource.data.get('targetCity', null) == myCity()) ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.merchantId == request.auth.uid &&
        request.resource.data.questions.size() <= 3 &&
        request.resource.data.status in ['active', 'draft', 'paused'] &&
        getMerchant(request.auth.uid).get('status', null) == 'verified' &&
        (getMerchant(request.auth.uid).get('city', null) == null ||
         request.resource.data.get('targetCity', null) == getMerchant(request.auth.uid).get('city', null));
      // answersCount/responsesCount ne sont plus incrémentables par le client : seule la
      // Cloud Function submitAnswer (SDK Admin, hors règles) les met à jour désormais. Le
      // commerçant ne peut pas non plus changer merchantId (transfert de propriété).
      allow update: if isAuth() && (
        isAdmin() ||
        (resource.data.merchantId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answersCount', 'responsesCount', 'merchantId']))
      );
      allow delete: if isAuth() && (resource.data.merchantId == request.auth.uid || isAdmin());
    }

    // ─── Answers ─────────────────────────────────────────────────────────────
    // Création : uniquement par l'auteur (userId doit matcher)
    // Lecture : par l'auteur OU par le commerçant de la campagne
    match /answers/{answerId} {
      // Seule la Cloud Function submitAnswer (SDK Admin, hors règles) crée des réponses
      // désormais — elle seule peut re-vérifier éligibilité/barème/doublon côté serveur.
      allow create: if false;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        (isFriendOf(resource.data.userId) && friendSharesAnswers(resource.data.userId)) ||
        isAdmin()
      );
      // Modération : l'admin peut uniquement lever/poser le flag anti-abus
      allow update: if isAuth() && isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagged']);
      // delete : uniquement par l'auteur (suppression de compte / droit à l'effacement)
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── Rewards ─────────────────────────────────────────────────────────────
    // Lecture : récompenses actives de MA ville pour tous les users connectés
    // Écriture : uniquement le commerçant propriétaire, vérifié
    match /rewards/{rewardId} {
      allow read: if isAuth() && (
        (resource.data.active == true && resource.data.get('city', null) == myCity()) ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      // Une récompense créée par un commerçant démarre toujours en attente de validation
      // admin — jamais visible/active tant qu'elle n'a pas été approuvée (voir update).
      allow create: if isAuth() &&
        request.resource.data.merchantId == request.auth.uid &&
        getMerchant(request.auth.uid).get('status', null) in ['pending', 'verified'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.active == false;
      allow update: if isAuth() && (
        isAdmin()
        ||
        // Commerçant : modification complète de son propre palier, mais il ne peut ni
        // s'auto-approuver/rejeter, ni s'auto-activer avant validation par l'admin.
        (resource.data.merchantId == request.auth.uid &&
         (request.resource.data.status == 'pending' || request.resource.data.status == resource.data.status) &&
         (request.resource.data.active == false || resource.data.status == 'approved'))
        ||
        // Utilisateur : uniquement incrémenter redeemedCount de 1
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedCount']) &&
         request.resource.data.redeemedCount == resource.data.redeemedCount + 1)
      );
      allow delete: if isAuth() && (resource.data.merchantId == request.auth.uid || isAdmin());
    }

    // ─── Redemptions ─────────────────────────────────────────────────────────
    // Création : par l'utilisateur concerné
    // Lecture : par l'utilisateur OU le commerçant concerné
    match /redemptions/{redemptionId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      // Le commerçant peut passer le bon à "used" (validation au comptoir)
      // L'habitant peut aussi presser « C'est validé » sur son propre bon en attente.
      allow update: if isAuth() &&
        (resource.data.merchantId == request.auth.uid ||
         (resource.data.userId == request.auth.uid && resource.data.status == 'pending')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt']) &&
        request.resource.data.status == 'used';
      // delete : uniquement par l'utilisateur concerné (suppression de compte / droit à l'effacement)
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── CommunityEvents ─────────────────────────────────────────────────────
    // Lecture : événements de MA ville uniquement
    // Création : uniquement pour soi-même
    match /communityEvents/{eventId} {
      allow read: if isAuth() && (resource.data.get('city', null) == myCity() || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

      // "J'aime" : un doc = un like d'un user (id = son uid), pour empêcher tout double-like
      // et éviter de devoir valider un diff de tableau dans les règles.
      match /likes/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && uid == request.auth.uid;
        allow delete: if isAuth() && uid == request.auth.uid;
      }

      // Commentaires : un par auteur identifié (userId == uid), texte court, supprimables par leur auteur.
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
        allow update: if false;
        allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ─── WeeklyQuestions ─────────────────────────────────────────────────────
    // Question communautaire hebdomadaire, publiée par l'admin dans le feed d'une ville
    // (ou de toutes). Lecture : tout user de la ville concernée. Écriture : admin seul.
    match /weeklyQuestions/{qId} {
      allow read: if isAuth() && (resource.data.get('city', null) == 'all' || resource.data.get('city', null) == myCity() || isAdmin());
      allow create, update, delete: if isAdmin();
      match /votes/{uid} {
        allow read: if isAuth();
        allow create: if isAuth() && uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── FriendCodes ─────────────────────────────────────────────────────────
    // Annuaire public des codes amis — lecture ouverte à tous les users connectés
    // Seul le propriétaire du code peut le créer (uid == auth.uid)
    match /friendCodes/{code} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── Broadcasts ──────────────────────────────────────────────────────────
    // Historique des notifications diffusées par l'admin
    match /broadcasts/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Chats ───────────────────────────────────────────────────────────────
    // Accès uniquement aux participants (stockés dans participants map du doc chat)
    match /chats/{chatId} {
      allow read: if isAuth() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if false;
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isAuth() &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if isAuth() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ─── Cities ──────────────────────────────────────────────────────────────
    match /cities/{cityId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Un habitant peut toujours créer/mettre à jour label+count (inscription) ;
      // seul l'admin peut changer 'active' (ouverture/fermeture de la ville).
      allow update: if isAuth() && (
        (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','count'])) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ─── Friend notifications ─────────────────────────────────────────────────
    match /friendNotifications/{notifId} {
      allow read: if isAuth() && resource.data.toUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Plan requests ────────────────────────────────────────────────────────
    match /planRequests/{reqId} {
      allow create: if isAuth() && request.resource.data.merchantId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    // ─── Invoices ─────────────────────────────────────────────────────────────
    match /invoices/{invId} {
      allow read: if isAuth() && resource.data.merchantId == request.auth.uid;
      allow write: if false;
    }

    // ─── Consent events ──────────────────────────────────────────────────────
    // Journal horodaté des octrois/révocations de consentement (preuve RGPD Art. 7).
    // Création : uniquement par l'utilisateur concerné. Lecture : l'utilisateur,
    // le commerçant concerné, ou l'admin. Jamais modifiable ni supprimable (journal).
    match /consentEvents/{eventId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    // ─── Notifications : journal, file d'attente et métriques écrits UNIQUEMENT par les Cloud Functions ───
    // (SDK Admin hors règles). Les métriques par type alimentent le back-office (lecture admin).
    match /notifMetrics/{type} { allow read: if isAdmin(); allow write: if false; }
    match /notifLog/{id}       { allow read: if isAdmin(); allow write: if false; }
    match /notifQueue/{id}     { allow read, write: if false; }
    // Compteurs de réponses par option (reveal) : serveur uniquement, jamais lisibles avant d'avoir répondu.
    match /campaignStats/{id}  { allow read, write: if false; }
    match /compatCache/{id}    { allow read, write: if false; }
    match /mail/{id}           { allow read, write: if false; }
  }
}
