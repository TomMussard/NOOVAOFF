{
  "rewrites": [
    { "source": "/app",       "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/noova_dashboard.html" },
    { "source": "/demo",      "destination": "/noova_dashboard_v2.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
